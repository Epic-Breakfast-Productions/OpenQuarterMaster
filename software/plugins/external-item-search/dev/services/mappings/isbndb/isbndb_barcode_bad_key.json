{
  "request": {
    "method": "GET",
    "urlPath": "/isbndb/book/(?!1503632431$)[^/]+",
    "headers": {
      "Authorization": {
        "equalTo": "^devKey$"
      }
    }
  },
  "response": {
    "status": 401,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "message": "Full authentication is required to access this resource."
    }
  }
}
