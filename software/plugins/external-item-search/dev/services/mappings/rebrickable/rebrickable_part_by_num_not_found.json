{
	"request": {
		"method": "GET",
		"urlPathTemplate": "/rebrickable/api/v3/lego/parts/{partNum}/",
		"pathParameters": {
			"partNum": {
				"not": {
					"equalTo": "012345"
				}
			}
		},
		"headers": {
			"Authorization": {
				"equalTo": "key devKey"
			}
		}
	},
	"response": {
		"status": 404,
		"delayDistribution": {
			"type": "lognormal",
			"median": 500,
			"sigma": 0.4
		},
		"headers": {
			"Content-Type": "application/json"
		},
		"jsonBody": {
			"detail": "No Part matches the given query."
		}
	}
}




